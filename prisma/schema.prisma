generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  delivery
  pickup
  dine_in
  takeaway
  phone
}

enum OrderSource {
  website
  pos
}

enum OrderStatus {
  placed
  confirmed
  preparing
  out_for_delivery
  ready_for_pickup
  delivered
  cancelled
}

enum AdminRole {
  owner
  branch_staff
}

model Branch {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  address          String
  phone            String
  lat              Float
  lng              Float
  hoursOpen        String
  hoursClose       String
  deliveryFee      Int
  deliveryRadiusKm Float
  isActive         Boolean     @default(true)
  orders           Order[]
  adminUsers       AdminUser[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id            String        @id @default(cuid())
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String        @unique
  description   String?
  price         Int
  imageUrl      String?
  hasHeatGauge  Boolean       @default(false)
  flavorOptions String[]
  isActive      Boolean       @default(true)
  isNew         Boolean       @default(false)
  isSignature   Boolean       @default(false)
  addonOptions  AddonOption[]
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model AddonOption {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id               String               @id @default(cuid())
  orderNumber      String               @unique
  branchId         String
  branch           Branch               @relation(fields: [branchId], references: [id])
  customerName     String
  customerPhone    String
  customerAddress  String?
  customerLat      Float?
  customerLng      Float?
  notes            String?
  orderType        OrderType
  source           OrderSource          @default(website)
  subtotal         Int
  deliveryFee      Int
  total            Int
  status           OrderStatus          @default(placed)
  estimatedReadyAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot       String
  unitPriceSnapshot  Int
  qty                Int
  selectedHeat       String?
  selectedFlavor     String?
  selectedAddons     Json?
  createdAt          DateTime @default(now())
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedAt DateTime    @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
